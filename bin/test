#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

for script in \
  "$ROOT/tests/unit/models-test.js" \
  "$ROOT/tests/unit/source-contracts-test.sh" \
  "$ROOT/tests/unit/repository-hygiene-test.sh"; do
  if [[ ! -f "$script" ]]; then
    printf 'missing test file: %s\n' "$script" >&2
    exit 1
  fi
done

node "$ROOT/tests/unit/models-test.js"
bash "$ROOT/tests/unit/source-contracts-test.sh"
bash "$ROOT/tests/unit/repository-hygiene-test.sh"
printf 'ok - portable tablet-mode suite passed\n'
